#
#
# Apollo Defconfig
#
#
CONFIG_BOEFFLA_WL_BLOCKER=y
CONFIG_CUSTOM_FORCETOUCH=y
CONFIG_SEC_INPUT_BOOSTER=y
CONFIG_ARGOS=y
CONFIG_ARGOS_CLUSTER_NUM=2
CONFIG_PROC_AVC=y
CONFIG_PAGE_BOOST=y
CONFIG_PAGE_BOOST_RECORDING=y
CONFIG_PROCESS_RECLAIM=y
CONFIG_INCREASE_MAXIMUM_SWAPPINESS=y
CONFIG_KSWAPD_CPU=0x3F

#
# MoroSound
#
CONFIG_MORO_SOUND=y

#
# Flar2 Wake Gestures
#
CONFIG_WAKE_GESTURES=y

#
# Wireguard
#
CONFIG_WIREGUARD=y
# CONFIG_WIREGUARD_DEBUG is not set


#
# Scheduler features
#
# CONFIG_PELT_HALFLIFE_32 is not set
CONFIG_PELT_HALFLIFE_16=y
# CONFIG_PELT_HALFLIFE_8 is not set

#
# IKHEADERS
#
CONFIG_IKHEADERS=y

# Enable power efficient workqueues

#
# Incremental Filesystem
#
CONFIG_INCREMENTAL_FS=y
# SUSFS v2.2.0 configuration
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# TRY_UMOUNT is off: SUSFS v2.2.0 deprecates the user-defined
# try_umount command and ships no susfs_add_try_umount(), while the
# KernelSU driver still calls it under this option. KSU's own default
# umount paths are unaffected.
# CONFIG_KSU_SUSFS_TRY_UMOUNT is not set
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
# SUS_MEMFD stays off: the KernelSU driver references
# CMD_SUSFS_ADD_SUS_MEMFD, which this SUSFS v2.2.0 patch does not define.
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set
